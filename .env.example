# Copy to .env for local development. In production, add these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# --- Public (used at build time, safe to expose) ---
# Production domain, no trailing slash. Used for canonical URLs, Open Graph, schema, sitemap, robots.txt.
VITE_SITE_URL=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (leave empty to disable)
VITE_GA_ID=
# Google Search Console "HTML tag" verification code (content value only; optional)
VITE_GSC_VERIFICATION=

# --- Server-only (used by /api/quote, never sent to the browser) ---
# Resend API key (https://resend.com)
RESEND_API_KEY=
# Inbox that receives quote requests
QUOTE_TO_EMAIL=
# Verified sender, e.g. AV Group Website <quotes@yourdomain.ca>
QUOTE_FROM_EMAIL=
