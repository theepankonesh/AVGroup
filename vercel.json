{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/services/landscaping-ottawa", "destination": "/services/grass-cutting-ottawa", "statusCode": 301 },
    { "source": "/services/residential-cleaning-ottawa", "destination": "/services/cleaning-services-ottawa#residential", "statusCode": 301 },
    { "source": "/services/commercial-cleaning-ottawa", "destination": "/services/cleaning-services-ottawa#commercial", "statusCode": 301 },
    { "source": "/commercial", "destination": "/services/cleaning-services-ottawa#commercial", "statusCode": 301 },
    { "source": "/landscaping-barrhaven", "destination": "/grass-cutting-barrhaven", "statusCode": 301 },
    { "source": "/landscaping-stittsville", "destination": "/grass-cutting-kanata", "statusCode": 301 },
    { "source": "/window-cleaning-orleans", "destination": "/window-cleaning-ottawa-east", "statusCode": 301 },
    { "source": "/quote", "destination": "/contact", "statusCode": 301 },
    { "source": "/blog/spring-cleanup-checklist-ottawa-homeowners", "destination": "/blog/how-often-should-you-cut-your-grass-ottawa", "statusCode": 301 },
    { "source": "/blog/fall-yard-prep-ottawa-lawn-ready-for-winter", "destination": "/blog/how-often-should-you-cut-your-grass-ottawa", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(favicon.ico|favicon-16x16.png|favicon-32x32.png|apple-touch-icon.png|android-chrome-192x192.png|android-chrome-512x512.png|site.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
